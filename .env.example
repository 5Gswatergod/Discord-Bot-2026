# Shared services
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guildforge?schema=public"
REDIS_URL="redis://localhost:6379"

# Discord application
DISCORD_CLIENT_ID="your-discord-application-client-id"
DISCORD_CLIENT_SECRET="your-discord-application-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_TEST_GUILD_ID=""
DISCORD_BOT_PERMISSIONS="8"

# Optional Twitch social alerts through Helix
TWITCH_CLIENT_ID=""
TWITCH_ACCESS_TOKEN=""

# Optional Reddit Data API notifications through OAuth
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="Hydrava/0.1 by your-reddit-username"

# Optional batch 5 integrations
AI_API_BASE_URL="https://your-ai-provider.example/v1"
AI_API_KEY=""
AI_MODEL=""
MEMBERSHIP_WEBHOOK_SECRET=""
WEB3_RPC_URLS_JSON=""

# Dashboard
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# Optional Docker service URL overrides
CONTAINER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/guildforge?schema=public"
CONTAINER_REDIS_URL="redis://redis:6379"

# Oracle Cloud production deployment
APP_DOMAIN="your-domain.example.com"
POSTGRES_PASSWORD="replace-with-url-safe-random-password"

# Optional tuning
GUILD_SYNC_LIMIT="100"

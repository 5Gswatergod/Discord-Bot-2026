{
  "name": "@guildforge/bot",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "tsx --test src/lib/economy/calculations.test.ts src/commands/commands.test.ts src/commands/batch1-utility-management.test.ts src/commands/batch2-community-engagement.test.ts src/commands/batch3-advanced-automation.test.ts src/commands/batch4-notification-platforms.test.ts",
    "register": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "@guildforge/config": "workspace:*",
    "@guildforge/database": "workspace:*",
    "@guildforge/shared": "workspace:*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  }
}

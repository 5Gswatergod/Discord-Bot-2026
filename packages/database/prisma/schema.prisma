generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleKey {
  MODERATION
  AUTO_MODERATION
  LEVELING
  ECONOMY
  WELCOME
  REACTION_ROLES
  CUSTOM_COMMANDS
  LOGGING
  GIVEAWAYS
  POLLS
  SOCIAL_ALERTS
  TICKETS
  INVITE_TRACKING
  EMBED_MESSAGES
  REMINDERS
  STARBOARD
  ACHIEVEMENTS
  BIRTHDAYS
  SERVER_STATS
  TEMPORARY_VOICE
  AUTOMATIONS
  MUSIC
  AI_ASSISTANT
  MEMBERSHIPS
  WEB3
}

enum ModerationAction {
  BAN
  KICK
  TIMEOUT
  WARN
  CLEAR
  MUTE
  UNMUTE
  SLOWMODE
  LOCK
  UNLOCK
}

enum AutoModTrigger {
  BANNED_WORD
  SPAM
  LINK
  MASS_MENTION
  INVITE_LINK
  REPEATED_MESSAGE
  CAPS_LOCK
}

enum AutoModPunishment {
  DELETE_MESSAGE
  WARN
  TIMEOUT
  KICK
  BAN
}

enum LogEvent {
  MESSAGE_DELETE
  MESSAGE_UPDATE
  MEMBER_JOIN
  MEMBER_LEAVE
  MEMBER_BAN
  MEMBER_UNBAN
  ROLE_CREATE
  ROLE_DELETE
  CHANNEL_CREATE
  CHANNEL_DELETE
  VOICE_JOIN
  VOICE_LEAVE
  MODERATION_ACTION
}

enum ReactionRoleMode {
  MULTI_SELECT
  SINGLE_SELECT
}

enum ReactionRoleOptionType {
  REACTION
  BUTTON
}

enum CustomCommandType {
  SLASH
  PREFIX
}

enum GiveawayStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum PollVisibility {
  PUBLIC
  ANONYMOUS
}

enum SocialAlertType {
  YOUTUBE
  TWITCH
  RSS
  TIKTOK
  X
  BLUESKY
  REDDIT
  INSTAGRAM
  KICK
  PODCAST
}

enum SocialAlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum EconomyTransactionType {
  MESSAGE_REWARD
  DAILY_REWARD
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_FEE
  LEVEL_REWARD
  SHOP_PURCHASE
  ADMIN_ADD
  ADMIN_REMOVE
  ADMIN_SET
  REFUND
}

enum EconomyShopItemType {
  ROLE
  COLLECTIBLE
}

enum EconomyShopItemStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum AchievementTrigger {
  MESSAGE_COUNT
  LEVEL
  INVITE_COUNT
}

enum ServerStatType {
  MEMBER_COUNT
  HUMAN_COUNT
  BOT_COUNT
  ROLE_COUNT
  TEXT_CHANNEL_COUNT
  VOICE_CHANNEL_COUNT
}

enum AutomationTrigger {
  MESSAGE_CREATE
  REACTION_ADD
  MEMBER_JOIN
  MEMBER_ROLE_UPDATE
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
  TEST
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum MembershipEntitlementStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  id        String   @id
  username  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Guild {
  id          String    @id
  name        String
  icon        String?
  ownerId     String?
  memberCount Int       @default(0)
  botJoinedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  config                  GuildConfig?
  moduleConfigs           ModuleConfig[]
  moderationCases         ModerationCase[]
  warnings                Warning[]
  autoModRules            AutoModRule[]
  levelingUsers           LevelingUser[]
  levelRewards            LevelReward[]
  welcomeConfig           WelcomeConfig?
  reactionRolePanels      ReactionRolePanel[]
  reactionRoleOptions     ReactionRoleOption[]
  customCommands          CustomCommand[]
  logConfigs              LogConfig[]
  giveaways               Giveaway[]
  giveawayEntries         GiveawayEntry[]
  polls                   Poll[]
  pollOptions             PollOption[]
  pollVotes               PollVote[]
  socialAlerts            SocialAlert[]
  socialAlertDeliveries   SocialAlertDelivery[]
  economyAccounts         EconomyAccount[]
  economyTransactions     EconomyTransaction[]
  economyShopItems        EconomyShopItem[]
  economyInventory        EconomyInventoryItem[]
  tickets                 Ticket[]
  inviteAttributions      InviteAttribution[]
  embedMessages           EmbedMessage[]
  reminders               Reminder[]
  starboardEntries        StarboardEntry[]
  achievements            Achievement[]
  achievementAwards       AchievementAward[]
  memberActivities        MemberActivity[]
  birthdays               Birthday[]
  serverStatChannels      ServerStatChannel[]
  temporaryVoice          TemporaryVoiceChannel[]
  automationRules         AutomationRule[]
  automationExecutions    AutomationExecution[]
  aiAssistantRequests     AiAssistantRequest[]
  membershipEntitlements  MembershipEntitlement[]
  membershipWebhookEvents MembershipWebhookEvent[]
  web3Wallets             Web3Wallet[]
  web3Verifications       Web3Verification[]
  auditLogs               AuditLog[]
}

model GuildConfig {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  locale              String   @default("zh-TW")
  commandPrefix       String   @default("!")
  defaultLogChannelId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ModuleConfig {
  id        String    @id @default(cuid())
  guildId   String
  module    ModuleKey
  enabled   Boolean   @default(false)
  settings  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, module])
  @@index([guildId])
}

model ModerationCase {
  id              String           @id @default(cuid())
  guildId         String
  caseNumber      Int
  action          ModerationAction
  targetUserId    String
  moderatorUserId String
  reason          String?
  durationSeconds Int?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  warnings Warning[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetUserId])
  @@index([guildId, moderatorUserId])
}

model Warning {
  id              String   @id @default(cuid())
  guildId         String
  caseId          String?
  targetUserId    String
  moderatorUserId String
  reason          String
  createdAt       DateTime @default(now())

  guild Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  case  ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([guildId, targetUserId])
  @@index([guildId, moderatorUserId])
}

model AutoModRule {
  id                        String            @id @default(cuid())
  guildId                   String
  name                      String
  trigger                   AutoModTrigger
  enabled                   Boolean           @default(true)
  pattern                   Json?
  ignoredChannelIds         String[]          @default([])
  ignoredRoleIds            String[]          @default([])
  punishment                AutoModPunishment @default(DELETE_MESSAGE)
  punishmentDurationSeconds Int?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, trigger])
}

model LevelingUser {
  id           String    @id @default(cuid())
  guildId      String
  userId       String
  xp           Int       @default(0)
  level        Int       @default(0)
  messageCount Int       @default(0)
  lastXpAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, level, xp])
}

model LevelReward {
  id        String   @id @default(cuid())
  guildId   String
  level     Int
  roleId    String
  stackable Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, level, roleId])
  @@index([guildId, level])
}

model EconomyAccount {
  id                  String    @id @default(cuid())
  guildId             String
  userId              String
  balance             Int       @default(0)
  lastDailyClaimDate  String?
  dailyStreak         Int       @default(0)
  lastMessageRewardAt DateTime?
  lastLevelRewarded   Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  guild        Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventory    EconomyInventoryItem[]
  transactions EconomyTransaction[]

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model EconomyTransaction {
  id            String                 @id @default(cuid())
  guildId       String
  accountId     String
  userId        String
  type          EconomyTransactionType
  amount        Int
  balanceAfter  Int
  actorUserId   String?
  relatedUserId String?
  shopItemId    String?
  referenceId   String?
  description   String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  guild    Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  account  EconomyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shopItem EconomyShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
  @@index([referenceId])
}

model EconomyShopItem {
  id           String                @id @default(cuid())
  guildId      String
  name         String
  description  String?
  type         EconomyShopItemType
  price        Int
  roleId       String?
  stock        Int?
  soldCount    Int                   @default(0)
  perUserLimit Int?
  status       EconomyShopItemStatus @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  guild        Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventory    EconomyInventoryItem[]
  transactions EconomyTransaction[]

  @@index([guildId, status])
  @@index([guildId, type])
}

model EconomyInventoryItem {
  id         String   @id @default(cuid())
  guildId    String
  accountId  String
  userId     String
  shopItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild    Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  account  EconomyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shopItem EconomyShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@unique([accountId, shopItemId])
  @@index([guildId, userId])
}

model WelcomeConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique
  enabled          Boolean  @default(false)
  welcomeChannelId String?
  welcomeMessage   String   @default("歡迎 {user} 加入 {server}！")
  goodbyeChannelId String?
  goodbyeMessage   String   @default("{username} 離開了 {server}。")
  autoRoleId       String?
  useEmbed         Boolean  @default(true)
  embedColor       String   @default("#24b47e")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ReactionRolePanel {
  id                         String           @id @default(cuid())
  guildId                    String
  channelId                  String
  publishedChannelId         String?
  messageId                  String?
  publishedReactionSignature String?
  title                      String
  description                String?
  color                      String           @default("#24b47e")
  mode                       ReactionRoleMode @default(MULTI_SELECT)
  enabled                    Boolean          @default(true)
  lastSyncedAt               DateTime?
  lastSyncError              String?
  deletedAt                  DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  guild   Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options ReactionRoleOption[]

  @@index([guildId, channelId])
  @@index([guildId, deletedAt, enabled])
}

model ReactionRoleOption {
  id        String                 @id @default(cuid())
  guildId   String
  panelId   String
  type      ReactionRoleOptionType @default(BUTTON)
  roleId    String
  emoji     String?
  label     String
  buttonId  String?
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  guild Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  panel ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, roleId])
  @@index([guildId])
}

model CustomCommand {
  id                String            @id @default(cuid())
  guildId           String
  name              String
  description       String?
  type              CustomCommandType @default(SLASH)
  responseText      String?
  responseEmbed     Json?
  imageUrl          String?
  cooldownSeconds   Int               @default(5)
  allowedRoleIds    String[]          @default([])
  allowedChannelIds String[]          @default([])
  enabled           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

model LogConfig {
  id        String   @id @default(cuid())
  guildId   String
  event     LogEvent
  enabled   Boolean  @default(false)
  channelId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, event])
  @@index([guildId])
}

model Giveaway {
  id              String         @id @default(cuid())
  guildId         String
  channelId       String
  messageId       String?
  prize           String
  winnerCount     Int            @default(1)
  requiredRoleId  String?
  createdByUserId String
  winners         String[]       @default([])
  startsAt        DateTime       @default(now())
  endsAt          DateTime
  status          GiveawayStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  guild   Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries GiveawayEntry[]

  @@index([guildId, status])
  @@index([guildId, endsAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  guildId    String
  giveawayId String
  userId     String
  createdAt  DateTime @default(now())

  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([guildId, userId])
}

model Poll {
  id              String         @id @default(cuid())
  guildId         String
  channelId       String
  messageId       String?
  question        String
  visibility      PollVisibility @default(PUBLIC)
  createdByUserId String
  endsAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([guildId, createdAt])
}

model PollOption {
  id        String   @id @default(cuid())
  guildId   String
  pollId    String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  guild Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, sortOrder])
  @@index([guildId])
}

model PollVote {
  id        String   @id @default(cuid())
  guildId   String
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  guild  Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([guildId, userId])
}

model SocialAlert {
  id                      String          @id @default(cuid())
  guildId                 String
  type                    SocialAlertType
  sourceId                String
  sourceUrl               String
  channelId               String
  mentionRoleId           String?
  mentionEveryone         Boolean         @default(false)
  messageTemplate         String
  lastSeenId              String?
  intervalSeconds         Int             @default(300)
  maxItemsPerCheck        Int             @default(3)
  maxNotificationsPerHour Int             @default(12)
  nextCheckAt             DateTime        @default(now())
  consecutiveFailures     Int             @default(0)
  lastError               String?
  lastErrorAt             DateTime?
  lastSuccessAt           DateTime?
  enabled                 Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  guild      Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  deliveries SocialAlertDelivery[]

  @@unique([guildId, type, sourceId])
  @@index([guildId, enabled, nextCheckAt])
}

model SocialAlertDelivery {
  id             String                    @id @default(cuid())
  guildId        String
  alertId        String
  externalItemId String
  itemUrl        String?
  status         SocialAlertDeliveryStatus @default(PENDING)
  attempts       Int                       @default(1)
  messageId      String?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  guild Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  alert SocialAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, externalItemId])
  @@index([guildId, status, createdAt])
  @@index([alertId, status, createdAt])
}

model Ticket {
  id              String       @id @default(cuid())
  guildId         String
  channelId       String       @unique
  ownerUserId     String
  claimedByUserId String?
  status          TicketStatus @default(OPEN)
  closeReason     String?
  createdAt       DateTime     @default(now())
  closedAt        DateTime?
  updatedAt       DateTime     @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, ownerUserId, status])
}

model InviteAttribution {
  id            String   @id @default(cuid())
  guildId       String
  memberUserId  String
  inviterUserId String?
  inviteCode    String?
  joinedAt      DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberUserId])
  @@index([guildId, inviterUserId])
  @@index([guildId, joinedAt])
}

model EmbedMessage {
  id           String    @id @default(cuid())
  guildId      String
  channelId    String
  messageId    String?
  content      String?
  title        String?
  description  String?
  color        String    @default("#24b47e")
  url          String?
  imageUrl     String?
  thumbnailUrl String?
  footerText   String?
  authorName   String?
  enabled      Boolean   @default(true)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, enabled])
  @@index([guildId, channelId])
}

model Reminder {
  id              String    @id @default(cuid())
  guildId         String
  channelId       String
  message         String
  nextRunAt       DateTime
  intervalSeconds Int?
  enabled         Boolean   @default(true)
  createdByUserId String
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, enabled, nextRunAt])
}

model StarboardEntry {
  id                 String   @id @default(cuid())
  guildId            String
  sourceChannelId    String
  sourceMessageId    String
  starboardChannelId String
  starboardMessageId String?
  authorUserId       String
  starCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, sourceMessageId])
  @@index([guildId, starboardChannelId])
}

model Achievement {
  id           String             @id @default(cuid())
  guildId      String
  name         String
  description  String?
  icon         String?
  trigger      AchievementTrigger
  threshold    Int
  rewardRoleId String?
  enabled      Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  guild  Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  awards AchievementAward[]

  @@unique([guildId, name])
  @@index([guildId, enabled, trigger])
}

model AchievementAward {
  id            String   @id @default(cuid())
  guildId       String
  achievementId String
  userId        String
  awardedAt     DateTime @default(now())

  guild       Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, userId])
  @@index([guildId, userId, awardedAt])
}

model MemberActivity {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, messageCount])
}

model Birthday {
  id                 String   @id @default(cuid())
  guildId            String
  userId             String
  month              Int
  day                Int
  year               Int?
  lastCelebratedYear Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

model ServerStatChannel {
  id         String         @id @default(cuid())
  guildId    String
  type       ServerStatType
  template   String
  categoryId String?
  channelId  String?
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, type])
  @@index([guildId, enabled])
}

model TemporaryVoiceChannel {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String   @unique
  ownerUserId String
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, ownerUserId])
}

model AutomationRule {
  id              String            @id @default(cuid())
  guildId         String
  name            String
  description     String?
  trigger         AutomationTrigger
  triggerConfig   Json?
  conditions      Json
  actions         Json
  position        Int               @default(0)
  enabled         Boolean           @default(true)
  stopProcessing  Boolean           @default(false)
  cooldownSeconds Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  guild      Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([guildId, name])
  @@index([guildId, enabled, trigger, position])
}

model AutomationExecution {
  id           String                    @id @default(cuid())
  guildId      String
  ruleId       String?
  trigger      AutomationTrigger
  status       AutomationExecutionStatus
  eventKey     String?
  actorUserId  String?
  targetUserId String?
  channelId    String?
  messageId    String?
  durationMs   Int?
  error        String?
  details      Json?
  createdAt    DateTime                  @default(now())

  guild Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rule  AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, eventKey])
  @@index([guildId, createdAt])
  @@index([ruleId, createdAt])
}

model AiAssistantRequest {
  id          String          @id @default(cuid())
  guildId     String
  userId      String
  channelId   String
  messageId   String?
  status      AiRequestStatus
  model       String?
  inputChars  Int             @default(0)
  outputChars Int             @default(0)
  error       String?
  createdAt   DateTime        @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, messageId])
  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
}

model MembershipEntitlement {
  id            String                      @id @default(cuid())
  guildId       String
  userId        String
  planKey       String
  status        MembershipEntitlementStatus
  source        String
  externalId    String?
  expiresAt     DateTime?
  lastEventAt   DateTime                    @default(now())
  lastSyncedAt  DateTime                    @default(now())
  roleAppliedAt DateTime?
  lastError     String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, planKey])
  @@unique([guildId, externalId])
  @@index([guildId, status, expiresAt])
}

model MembershipWebhookEvent {
  id         String   @id @default(cuid())
  guildId    String
  eventId    String
  receivedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, eventId])
  @@index([guildId, receivedAt])
}

model Web3Wallet {
  id                 String    @id @default(cuid())
  guildId            String
  userId             String
  address            String
  challenge          String
  challengeExpiresAt DateTime
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  verifications Web3Verification[]

  @@unique([guildId, userId])
  @@unique([guildId, address])
  @@index([guildId, verifiedAt])
}

model Web3Verification {
  id            String    @id @default(cuid())
  guildId       String
  walletId      String
  collectionKey String
  balance       String    @default("0")
  eligible      Boolean   @default(false)
  lastCheckedAt DateTime  @default(now())
  roleAppliedAt DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  guild  Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  wallet Web3Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, collectionKey])
  @@index([guildId, eligible, lastCheckedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  guildId     String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, actorUserId])
}
